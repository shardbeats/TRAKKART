/* TRAKKART — ShardBeats TRAKK SUITE theme (GPL-3.0-only, original code).
   Shared tokens: bg #151617, panels #1C1D1F/#202124,
   borders #45474A, text #E5E5E5, dim #92959A, accent #F5A623. */

QMainWindow, QWidget {
    background-color: #151617;
    color: #E5E5E5;
    font-family: "Inter", "Segoe UI", system-ui, sans-serif;
    font-size: 13px;
}

QLabel#titleLabel {
    font-size: 20px;
    font-weight: bold;
    color: #E5E5E5;
    letter-spacing: 2px;
}

QLabel#valueLabel {
    font-size: 12px;
    font-weight: bold;
    color: #F5A623;
}

/* Section header inside an accordion page: one hierarchy level above
   the slider labels, quieter than the page button itself. */
QLabel#sectionLabel {
    color: #B8BBC0;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 1px;
    padding-top: 8px;
    padding-bottom: 4px;
    border-bottom: 1px solid #2C2E31;
    margin-bottom: 2px;
}

QLabel#subtitleLabel {
    font-size: 12px;
    color: #92959A;
}

QLabel#previewTitle {
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 1px;
    color: #92959A;
}

QLabel#vecLabel {
    font-size: 12px;
    color: #92959A;
}

/* Soft warnings (output pixel budget): amber, never blocks the action. */
QLabel[warning="true"] {
    color: #F5A623;
}

QGroupBox {
    background-color: #1C1D1F;
    border: 1px solid #45474A;
    border-radius: 6px;
    margin-top: 14px;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 1px;
    color: #92959A;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    background-color: transparent;
}

QPushButton {
    background-color: #202124;
    border: 1px solid #45474A;
    border-radius: 6px;
    padding: 8px 12px;
    min-height: 24px;
    color: #E5E5E5;
    font-weight: bold;
    font-size: 12px;
}

QPushButton:hover {
    border-color: #F5A623;
    color: #F5A623;
}

QPushButton:pressed {
    background-color: #F5A623;
    border-color: #F5A623;
    color: #161617;
}

/* Checkable toggles (link, details, preview switches) show state. */
QPushButton:checked {
    background-color: #2A2C30;
    border-color: #F5A623;
    color: #F5A623;
}

QPushButton#opBtn {
    padding: 8px 8px;
    font-size: 12px;
    min-height: 24px;
    min-width: 48px;
}

QPushButton#accordion {
    text-align: left;
    background-color: #1A1B1D;
    border: 1px solid #2C2E31;
    border-radius: 6px;
    padding: 8px 12px;
    color: #C9CBCE;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 1px;
}

QPushButton#accordion:hover {
    border-color: #F5A623;
    color: #F5A623;
}

QPushButton#accordion:checked {
    background-color: #232528;
    border: 1px solid #3A3C40;
    border-left: 3px solid #F5A623;
    color: #F5A623;
}

QPushButton:disabled {
    background-color: #1C1D1F;
    border-color: #45474A;
    color: #6B6E73;
}

QPushButton#exportBtn {
    background-color: #F5A623;
    border: none;
    border-radius: 8px;
    padding: 12px 24px;
    min-height: 28px;
    color: #161617;
    font-size: 15px;
    font-weight: bold;
    letter-spacing: 2px;
}

QPushButton#exportBtn:hover {
    background-color: #FFB52E;
    color: #161617;
}

QPushButton#exportBtn:pressed {
    background-color: #D8901D;
    color: #161617;
}

QPushButton#exportBtn:disabled {
    background-color: #2A2C30;
    border: 1px solid #45474A;
    color: #6B6E73;
}

QComboBox, QSpinBox, QDoubleSpinBox, QLineEdit {
    background-color: #202124;
    border: 1px solid #45474A;
    border-radius: 6px;
    padding: 6px 10px;
    min-height: 22px;
    color: #E5E5E5;
    font-size: 12px;
    selection-background-color: #F5A623;
    selection-color: #161617;
}

QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover, QLineEdit:hover {
    border-color: #F5A623;
}

QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QLineEdit:focus {
    border-color: #F5A623;
}

QComboBox QAbstractItemView {
    background-color: #202124;
    color: #E5E5E5;
    selection-background-color: #F5A623;
    selection-color: #161617;
    outline: none;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    background-color: #2A2C30;
    border: none;
    width: 16px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #F5A623;
}

QSlider::groove:horizontal {
    background-color: #202124;
    border: 1px solid #45474A;
    border-radius: 3px;
    height: 8px;
}

QSlider::handle:horizontal {
    background-color: #F5A623;
    border: none;
    border-radius: 9px;
    width: 18px;
    height: 18px;
    margin: -6px 0;
}

QSlider::handle:horizontal:hover {
    background-color: #FFB52E;
}

QSlider::sub-page:horizontal {
    background-color: #5A451F;
    border-radius: 3px;
}

QCheckBox {
    color: #E5E5E5;
    font-size: 12px;
    spacing: 6px;
}

QCheckBox:hover {
    color: #F5A623;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #45474A;
    border-radius: 3px;
    background-color: #202124;
}

QCheckBox::indicator:checked {
    background-color: #F5A623;
    border-color: #F5A623;
    image: url("__CHECK__");
}

QProgressBar {
    background-color: #202124;
    border: 1px solid #45474A;
    border-radius: 6px;
    text-align: center;
    color: #E5E5E5;
    font-weight: bold;
    font-size: 12px;
}

QProgressBar::chunk {
    background-color: #F5A623;
    border-radius: 3px;
}

QMenuBar {
    background-color: #151617;
    color: #E5E5E5;
}

QMenuBar::item:selected {
    background-color: #2A2C30;
    color: #F5A623;
}

QMenu {
    background-color: #202124;
    border: 1px solid #45474A;
    color: #E5E5E5;
}

QMenu::item {
    padding: 6px 30px 6px 28px;
}

QMenu::item:selected {
    background-color: #2A2C30;
    color: #F5A623;
}

QMenu::separator {
    height: 1px;
    background-color: #45474A;
    margin: 4px 0;
}

QStatusBar {
    background-color: #1C1D1F;
    border-top: 1px solid #45474A;
    color: #92959A;
    font-size: 12px;
}

QStatusBar::item {
    border: none;
}

QScrollBar:vertical {
    background-color: #1C1D1F;
    width: 8px;
    border: none;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: #45474A;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: #F5A623;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollArea {
    border: none;
    background-color: #151617;
}

QToolTip {
    background-color: #202124;
    color: #E5E5E5;
    border: 1px solid #45474A;
    padding: 4px;
}

QMessageBox {
    background-color: #1C1D1F;
}

QMessageBox QLabel {
    color: #E5E5E5;
}

QInputDialog QLineEdit {
    background-color: #202124;
    color: #E5E5E5;
}

QPushButton:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QLineEdit:focus, QCheckBox:focus, QRadioButton:focus, QSlider:focus,
QListWidget:focus {
    border: 2px solid #FFB52E;
    outline: none;
}

QComboBox:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QLineEdit:disabled {
    background-color: #1C1D1F;
    color: #6B6E73;
    border-color: #2C2E31;
}

QSlider::handle:horizontal:disabled {
    background-color: #6B6E73;
}

QSlider::handle:horizontal:focus {
    border: 2px solid #FFB52E;
}

QCheckBox:disabled {
    color: #6B6E73;
}

QCheckBox::indicator:disabled {
    background-color: #1C1D1F;
    border-color: #6B6E73;
}

QRadioButton {
    color: #E5E5E5;
    font-size: 12px;
    spacing: 6px;
}

QRadioButton:hover {
    color: #F5A623;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #45474A;
    border-radius: 9px;
    background-color: #202124;
}

QRadioButton::indicator:checked {
    background-color: #F5A623;
    border: 4px solid #202124;
}

QListWidget {
    background-color: #1C1D1F;
    border: 1px solid #2C2E31;
    border-radius: 6px;
    color: #E5E5E5;
    font-size: 12px;
    outline: none;
}

QListWidget::item {
    padding: 5px 8px;
    border-bottom: 1px solid #232528;
}

QListWidget::item:selected {
    background-color: #2A2C30;
    color: #F5A623;
}

QListWidget::item:hover {
    background-color: #232528;
}

QLabel#previewFrame {
    background-color: #000000;
    border: 1px solid #45474A;
    border-radius: 8px;
}

QLabel#previewFrame[dragHover="true"] {
    border: 2px solid #F5A623;
    background-color: #1C1D1F;
}

QLabel#previewEmpty {
    font-size: 13px;
    color: #92959A;
}

QLabel#previewEmptyTitle {
    font-size: 20px;
    font-weight: bold;
    color: #E5E5E5;
}

/* Motion: Qt QSS has no transitions; hover/pressed feedback is instant
   by design (dither canvas stays crisp). Reduced motion honored in
   Python via TRAKKART_REDUCED_MOTION=1 (timers 500/700ms). */
QPushButton#emptyCta {
    padding: 8px 16px;
    min-height: 24px;
}

/* Settings sidebar nav (design/shadcn Tabs equivalent): quiet list,
   active section reads as navigation (left accent + amber text). */
QListWidget#settingsNav {
    background-color: #1A1B1D;
    border: 1px solid #2C2E31;
    border-radius: 6px;
    color: #C9CBCE;
    font-size: 12px;
    font-weight: bold;
    outline: none;
}

QListWidget#settingsNav::item {
    padding: 8px 12px;
    border-bottom: 1px solid #232528;
    border-left: 3px solid transparent;
}

QListWidget#settingsNav::item:selected {
    background-color: #232528;
    border-left: 3px solid #F5A623;
    color: #F5A623;
}

QListWidget#settingsNav::item:hover {
    background-color: #232528;
}
